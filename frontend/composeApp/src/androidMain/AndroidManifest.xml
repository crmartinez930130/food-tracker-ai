<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Opt-in meal reminders: notifications (Android 13+ runtime) and re-arming alarms after reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The app falls back to the gallery without a camera, so don't filter camera-less devices. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- API 30+ package visibility: lets the app find the system speech recognizer for dictation. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <!-- Settings (incl. the backend's access token) never leave the phone: no cloud backup and no
         device-to-device transfer. Cleartext is needed for the home-network backend over http://
         (see README "Security"). -->
    <application
        android:label="Food Tracker"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.FoodTracker">
        <!-- locale: the app sets its own per-app language (see AppLocale.android.kt); Compose
             re-resolves strings itself, so a recreate would only lose the current screen. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode|locale|layoutDirection"
            android:exported="true"
            android:theme="@style/Theme.FoodTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Meal reminder alarms, plus the system broadcasts after which alarms must be re-registered.
             Not exported: the system still delivers its own broadcasts, and alarms use an explicit intent. -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Shares CSV exports from the cache with other apps (see res/xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
