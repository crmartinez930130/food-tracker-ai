# Copy this file to .env and fill in your own values. .env is gitignored.

# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Required: the access token every API request must send (Authorization: Bearer <token>).
# Use a random value of at least 16 characters, e.g. the output of `openssl rand -hex 24`,
# and enter the same value in the app (Options > Server > Access token).
API_TOKEN=change-me-to-a-random-value

# Optional: meal analyses accepted per minute (each one is a paid API call). Defaults to 20.
ANALYZE_RATE_LIMIT_PER_MINUTE=20

# Optional: vision model to use for meal analysis. Defaults to claude-opus-5.
# Lower-cost alternatives: claude-sonnet-5, claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-5

# Optional: HTTP server bind host/port. Host defaults to 0.0.0.0 so the app
# on your phone can reach it over your home network; port defaults to 3000.
HOST=0.0.0.0
PORT=3000

# Optional: path to the SQLite database file, relative to backend/.
DB_PATH=data/food-tracker.sqlite
